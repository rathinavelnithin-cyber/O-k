local currentTarget = nil

-- mousemoverel (the important part for killcam)
local moveMouse = mousemoverel or (Input and Input.MouseMove) or function(x, y)
    local current = Camera.CFrame
    Camera.CFrame = current * CFrame.Angles(-math.rad(y * 0.07), -math.rad(x * 0.07), 0)
end

