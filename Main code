-- ==================== HELPERS ====================
local function isAlive(plr)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isVisible(part)
    if not Config.VisibleCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local result = workspace:Raycast(origin, dir, params)
    return not result or result.Instance:IsDescendantOf(part.Parent)
end

local function CalcChance(percentage)
    percentage = math.floor(percentage)
    local chance = math.floor(Random.new():NextNumber(0, 1) * 100) / 100
    return chance <= (percentage / 100)
end

local function getAimPart(char)
    if not char then return nil end
    local partName = Config.AimPart
    if partName == "Random" then
        local pool = {"Head", "UpperTorso", "HumanoidRootPart", "Torso"}
        partName = pool[math.random(1, #pool)]
    end
    local part = char:FindFirstChild(partName)
    if part then return part end
    if partName == "UpperTorso" or partName == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
    if partName == "LowerTorso" then
        return char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function getBestTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local best = nil
    local bestDist = Config.FOV

    if Config.Sticky and currentTarget and currentTarget.Parent then
        local plr = Players:GetPlayerFromCharacter(currentTarget.Parent)
        if plr and isAlive(plr) then
            local part = getAimPart(currentTarget.Parent)
            if part then
                local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and screen.Z > 0 then
                    local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                    if dist < Config.FOV * 1.55 and isVisible(part) then
                        return part
                    end
                end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) then
            if Config.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
                continue
            end
            local char = plr.Character
            local part = getAimPart(char)
            if part then
                local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and screen.Z > 0 then
                    local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                    local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
                    if dist < bestDist and worldDist < Config.MaxDistance and isVisible(part) then
                        bestDist = dist
                        best = part
                    end
                end
            end
        end
    end
    return best
end

-- humanized movement (the part that keeps detection low while still feeling strong)
local function humanizedDelta(dx, dy)
    if not Config.Humanize then
        return dx * Config.Strength * Config.Smoothness,
               dy * Config.Strength * Config.Smoothness
    end

    if math.random() < Config.MicroPauseChance then
        return 0, 0
    end

    local strength = Config.Strength * (0.82 + math.random() * 0.28)
    local smooth   = Config.Smoothness * (0.85 + math.random() * 0.30)

    local mag = math.sqrt(dx*dx + dy*dy)
    local factor = 1
    if mag > 2 then
        factor = 1 - math.exp(-mag * 0.022)
    end

    local moveX = dx * strength * smooth * factor
    local moveY = dy * strength * smooth * factor

    if math.random() < Config.OvershootChance and mag > 10 then
        moveX = moveX * (1.12 + math.random() * 0.18)
        moveY = moveY * (1.12 + math.random() * 0.18)
    end

    moveX = moveX + (math.random() - 0.5) * 0.95
    moveY = moveY + (math.random() - 0.5) * 0.95

    moveX = math.clamp(moveX, -55, 55)
    moveY = math.clamp(moveY, -55, 55)

    return moveX, moveY
end

-- input
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Config.HoldKey then
        isHoldingKey = true
    end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        isHoldingKey = true
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Config.HoldKey then
        isHoldingKey = false
        currentTarget = nil
        reactionUntil = 0
    end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        if not UserInputService:IsKeyDown(Config.HoldKey) then
            isHoldingKey = false
            currentTarget = nil
        end
    end
end)

-- ==================== MAIN LOOP ====================
RunService:BindToRenderStep("VexoraHybrid", Enum.RenderPriority.Camera.Value + 1, function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    FOVCircle.Radius   = Config.FOV
    FOVCircle.Visible  = Config.ShowFOV and Config.Enabled and (not Config.HoldMode or isHoldingKey)

    if not Config.Enabled then
        currentTarget = nil
        return
    end

    if Config.HoldMode and not isHoldingKey then
        currentTarget = nil
        return
    end

    if not CalcChance(Config.HitChance) then
        return
    end

    local now = tick()
    local head = getBestTarget()

    if head ~= currentTarget then
        currentTarget = head
        if head then
            reactionUntil = now + Config.ReactionMin + math.random() * (Config.ReactionMax - Config.ReactionMin)
        end
    end

    if not currentTarget or now < reactionUntil then
        return
    end

    local part = currentTarget
    local pos  = part.Position

    if Config.Humanize then
        local j = Config.BoneJitter
        pos = pos + Vector3.new(
            (math.random() - 0.5) * j,
            (math.random() - 0.5) * j * 0.65,
            (math.random() - 0.5) * j
        )
    end

    local vel = part.AssemblyLinearVelocity or Vector3.zero
    local predicted = pos + (vel * Config.Prediction)

    if Config.UseMouseMove then
        local screenPos, onScreen = Camera:WorldToViewportPoint(predicted)
        if not onScreen or screenPos.Z <= 0 then return end

        local mousePos = UserInputService:GetMouseLocation()
        local deltaX = screenPos.X - mousePos.X
        local deltaY = screenPos.Y - mousePos.Y

        local moveX, moveY = humanizedDelta(deltaX, deltaY)
        if moveX ~= 0 or moveY ~= 0 then
            moveMouse(moveX, moveY)
        end
    else
        local current = Camera.CFrame
        local target  = CFrame.lookAt(current.Position, predicted)
        local alpha   = Config.Strength * Config.Smoothness * 0.75
        if Config.Humanize then
            alpha = alpha * (0.75 + math.random() * 0.35)
        end
        Camera.CFrame = current:Lerp(target, math.clamp(alpha, 0.02, 0.35))
    end
end)

