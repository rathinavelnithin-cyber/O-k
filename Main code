    Enabled = true,
    FOV = 220,
    Prediction = 0.165,
    TeamCheck = false,
    VisibleCheck = false,
    ShowFOV = true,
    Sticky = true,
    MaxDistance = 2000,
    Strength = 0.92,          -- almost V-90 hard lock
    HitChance = 100,
    AimPart = "Head",
    Smoothness = 0.55,        -- high = snaps hard (V-90 feeling)
    Humanize = false,         -- off by default so it feels strong
