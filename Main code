-- ==================== HELPERS ====================
local function isAlive(plr)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isVisible(part)
    if not Config.VisibleCheck then return true end
    local origin = Camera.CFrame.Position
    local dir = (part.Position - origin)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local result = workspace:Raycast(origin, dir, params)
    return not result or result.Instance:IsDescendantOf(part.Parent)
end

local function CalcChance(percentage)
    percentage = math.floor(percentage)
    local chance = math.floor(Random.new():NextNumber(0, 1) * 100) / 100
    return chance <= (percentage / 100)
end

local function getAimPart(char)
    if not char then return nil end
    local partName = Config.AimPart or "Head"
    local part = char:FindFirstChild(partName)
    if part then return part end
    if partName == "UpperTorso" or partName == "Torso" then
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
    if partName == "LowerTorso" then
        return char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso")
    end
    return char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function getBestHead()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local best = nil
    local bestDist = Config.FOV

    if Config.Sticky and currentTarget and currentTarget.Parent then
        local plr = Players:GetPlayerFromCharacter(currentTarget.Parent)
        if plr and isAlive(plr) then
            local part = getAimPart(currentTarget.Parent)
            if part then
                local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and screen.Z > 0 then
                    local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                    if dist < Config.FOV * 1.5 and isVisible(part) then
                        return part
                    end
                end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) then
            if Config.TeamCheck and plr.Team and LocalPlayer.Team and plr.Team == LocalPlayer.Team then
                continue
            end
            local char = plr.Character
            local part = getAimPart(char)
            if part then
                local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and screen.Z > 0 then
                    local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                    local worldDist = (part.Position - Camera.CFrame.Position).Magnitude
                    if dist < bestDist and worldDist < Config.MaxDistance and isVisible(part) then
                        bestDist = dist
                        best = part
                    end
                end
            end
        end
    end
    return best
end

-- ==================== MAIN LOCK (V-90 power + mouse move) ====================
RunService:BindToRenderStep("VexoraV90Killcam", Enum.RenderPriority.Camera.Value + 1, function()
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    FOVCircle.Radius = Config.FOV
    FOVCircle.Visible = Config.ShowFOV and Config.Enabled

    if not Config.Enabled then
        currentTarget = nil
        return
    end

    if not CalcChance(Config.HitChance) then
        return
    end

    local head = getBestHead()
    currentTarget = head

    if not head then return end

    local pos = head.Position
    local vel = head.AssemblyLinearVelocity or Vector3.zero
    local predicted = pos + (vel * Config.Prediction)

    if Config.UseMouseMove then
        -- KILLCAM-SAFE PATH (real mouse moves → crosshair sits on them)
        local screenPos, onScreen = Camera:WorldToViewportPoint(predicted)
        if not onScreen or screenPos.Z <= 0 then return end

        local mousePos = UserInputService:GetMouseLocation()
        local deltaX = screenPos.X - mousePos.X
        local deltaY = screenPos.Y - mousePos.Y

        local moveX = deltaX * Config.Strength * Config.Smoothness
        local moveY = deltaY * Config.Strength * Config.Smoothness

        if Config.Humanize then
            moveX = moveX + (math.random() - 0.5) * 1.4
            moveY = moveY + (math.random() - 0.5) * 1.4
        end

        -- high clamp so it can still snap hard like V-90
        moveX = math.clamp(moveX, -150, 150)
        moveY = math.clamp(moveY, -150, 150)

        moveMouse(moveX, moveY)
    else
        -- old pure camera lock (same as original V-90)
        local current = Camera.CFrame
        local target = CFrame.lookAt(current.Position, predicted)
        Camera.CFrame = current:Lerp(target, Config.Strength)
    end
end)

